{
	"name": "@sqrrl/api",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "HTTP API server for the Sqrrl memory platform",
	"scripts": {
		"start": "node --import tsx src/server.ts",
		"dev": "node --import tsx --watch src/server.ts",
		"build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check-types": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run src/",
		"eval:task-review": "node --import tsx src/eval/task-review-eval.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.0",
		"@sqrrl/lib": "workspace:*",
		"@sqrrl/source-layer": "workspace:*",
		"@sqrrl/wiki-engine": "workspace:*",
		"hono": "^4.12.0",
		"tsx": "^4.19.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"typescript": "^5.8.0",
		"vitest": "^4.1.0"
	}
}
