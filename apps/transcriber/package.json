{
	"name": "@sqrrl/transcriber",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Local CPU speech-to-text with an OpenAI-compatible /v1/audio/transcriptions API",
	"scripts": {
		"start": "node --import tsx src/server.ts",
		"build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit false --rootDir src --outDir dist",
		"check-types": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run src/"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.0",
		"@huggingface/transformers": "4.3.0",
		"busboy": "1.6.0",
		"ffmpeg-static": "5.3.0",
		"hono": "^4.12.0",
		"tsx": "^4.19.0",
		"@sqrrl/lib": "workspace:*"
	},
	"devDependencies": {
		"@types/busboy": "1.5.4",
		"@types/node": "^22.10.0",
		"typescript": "^5.8.0",
		"vitest": "^4.1.0"
	}
}
