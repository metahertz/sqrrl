{
	"name": "@sqrrl/source-layer",
	"version": "0.1.0",
	"private": true,
	"description": "Layer 1: raw source items and the distillers that turn them into wiki pages, tasks and graph links",
	"type": "module",
	"license": "Apache-2.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
		"check-types": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run src/"
	},
	"dependencies": {
		"@sqrrl/lib": "workspace:*",
		"@sqrrl/wiki-engine": "workspace:*",
		"mongodb": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"typescript": "^5.8.0",
		"vitest": "^4.1.0"
	}
}
