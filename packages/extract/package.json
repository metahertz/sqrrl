{
	"name": "@sqrrl/extract",
	"version": "0.1.0",
	"private": true,
	"description": "Turns documents, images and recordings into text for sqrrl connectors, using local tools and OpenAI-compatible vision and transcription endpoints",
	"type": "module",
	"license": "Apache-2.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		}
	},
	"scripts": {
		"build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
		"check-types": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run src/"
	},
	"dependencies": {
		"@napi-rs/canvas": "^1.0.9",
		"fflate": "^0.8.3",
		"ffmpeg-static": "^5.3.0",
		"heic-decode": "^2.1.0",
		"pdfjs-dist": "^6.3.289",
		"unpdf": "^1.8.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"typescript": "^5.8.0",
		"vitest": "^4.1.0"
	}
}
