# SQRRL local development example

# SQRRL-owned wiki MongoDB (replica set or sharded cluster required)
SQRRL_WIKI_MONGODB_URI="mongodb://127.0.0.1:27017/?replicaSet=rs0"
SQRRL_WIKI_DATABASE="sqrrl_wiki"
SQRRL_WIKI_COLLECTION_PREFIX="sqrrl_"
SQRRL_DELIVERY_RECONCILE_MS="5000"


# HTTP API
SQRRL_API_HOST="127.0.0.1"
SQRRL_API_PORT="3847"
SQRRL_API_KEY="local-dev-secret"

# Logging (debug | info | warn | error; default info)
SQRRL_LOG_LEVEL="info"

# Atlas Local Preview / wiki auto-embed
# Use a MongoDB Atlas Model API key with the al-... prefix.
# Specific sub-keys take priority over the generic VOYAGE_API_KEY.
VOYAGE_API_KEY=""
VOYAGE_API_INDEXING_KEY=""
VOYAGE_API_QUERY_KEY=""
VOYAGE_RERANK_API_KEY=""

# Optional LLM enrichment and real-agent smoke tests.
# OpenAI-compatible providers default to Authorization: Bearer.
SQRRL_ENRICHMENT_API_KEY=""
SQRRL_ENRICHMENT_BASE_URL="https://api.openai.com/v1"
SQRRL_ENRICHMENT_MODEL="gpt-4o-mini"
SQRRL_ENRICHMENT_AUTH_STYLE="authorization-bearer"
SQRRL_ENRICHMENT_TOKEN_PARAM="max_tokens"

SQRRL_LLM_API_KEY=""
SQRRL_LLM_BASE_URL="https://api.openai.com/v1"
SQRRL_LLM_MODEL="gpt-4o-mini"
SQRRL_LLM_AUTH_STYLE="authorization-bearer"
SQRRL_LLM_TOKEN_PARAM="max_tokens"
# Ask checks every citation with a second LLM call; "off" skips it.
# SQRRL_ANSWER_VERIFY="off"

# Scoped API keys (JSON array). Optional; overrides SQRRL_API_KEY per agent.
# Example: [{"token":"sk-agent1","agentIds":["agent-1"]}]
SQRRL_API_SCOPED_KEYS=""
