{
	"name": "sqrrl",
	"private": true,
	"description": "MongoDB-native LLM wiki / company brain with reasoning chains, novelty detection, and consolidation: engine, SDK, HTTP API, MCP server, and web console",
	"license": "Apache-2.0",
	"packageManager": "bun@1.2.5",
	"engines": {
		"node": ">=20.19.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "turbo run test && bunx vitest run scripts/*.test.ts",
		"check-types": "turbo run check-types",
		"check-publishability": "bun scripts/check-publishability.ts",
		"lint": "biome check . --diagnostic-level=error",
		"lint:fix": "biome check . --diagnostic-level=error --write",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"mongodb:cluster-preflight": "bun scripts/mongodb-cluster-preflight.ts",
		"wiki:init": "bun run scripts/sqrrl-init.ts",
		"wiki:backfill-permissions": "node --import tsx scripts/backfill-okf-permissions.ts",
		"stress-test": "bun run scripts/stress-test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@sqrrl/client": "workspace:*",
		"@sqrrl/wiki-engine": "workspace:*",
		"fast-check": "^4.8.0",
		"mongodb": "^7.0.0",
		"tsx": "^4.19.0",
		"turbo": "^2.5.0",
		"typescript": "^5.8.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/metahertz/sqrrl.git"
	},
	"homepage": "https://github.com/metahertz/sqrrl#readme"
}
